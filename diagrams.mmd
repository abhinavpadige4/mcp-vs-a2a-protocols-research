%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#1976d2', 'secondaryColor': '#42a5f5', 'tertiaryColor': '#90caf6', 'lineColor': '#f5f5f5' }}}%%
%% MCP vs A2A Protocol Comparison Diagrams %%

%% Diagram 1: Architecture Stack Comparison %%
graph TD
    subgraph "AI Agent Ecosystem Stack"
        direction TB
        
        %% Application Layer
        subgraph Application_Layer [Application Layer]
            AI_Agent[AI Agent Logic<br/>Task Planning & Reasoning]
            Workflow_Orchestrator[Workflow Orchestrator<br/>Complex Task Decomposition]
        end
        
        %% Integration Layer
        subgraph Integration_Layer [Integration Layer]
            direction TB
            MCP_Layer[MCP Layer<br/>Model Context Protocol<br/>Agent ↔ Tools/Data]
            A2A_Layer[A2A Layer<br/>Agent2Agent Protocol<br/>Agent ↔ Agent]
        end
        
        %% Transport Layer
        subgraph Transport_Layer [Transport Layer]
            direction TB
            JSONRPC[JSON-RPC 2.0<br/>Flexible Transport<br/>(stdio, HTTP, WS)]
            HTTP_JSON[HTTP/JSON<br/>Mandated Transport<br/>RESTful Principles]
        end
        
        %% Capability Layer
        subgraph Capability_Layer [Capability Layer]
            direction TB
            Tools_Resources[Tools & Resources<br/>File Systems, Databases, APIs<br/>Computational Functions]
            Remote_Agents[Remote Agents<br/>Specialized AI Services<br/>Domain Expertise]
        end
        
        %% Connections
        AI_Agent -->|Uses| MCP_Layer
        Workflow_Orchestrator -->|Uses| A2A_Layer
        MCP_Layer -->|JSON-RPC 2.0| JSONRPC
        A2A_Layer -->|HTTP/JSON| HTTP_JSON
        JSONRPC -->|Accesses| Tools_Resources
        HTTP_JSON -->|Delegates to| Remote_Agents
        
        %% Styling
        classDef application fill:#e3f2fd,stroke:#1565c0,stroke-width:2px;
        classDef integration fill:#fff3e0,stroke:#ef6c00,stroke-width:2px;
        classDef transport fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px;
        classDef capability fill:#e8f5e8,stroke:#2e7d32,stroke-width:2px;
        
        class AI_Agent,Workflow_Orchestrator application
        class MCP_Layer,A2A_Layer integration
        class JSONRPC,HTTP_JSON transport
        class Tools_Resources,Remote_Agents capability
