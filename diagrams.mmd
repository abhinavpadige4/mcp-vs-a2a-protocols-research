%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#1976d2', 'secondaryColor': '#42a5f5', 'tertiaryColor': '#90caf6', 'lineColor': '#f5f5f5' }}}%%
%% Diagram 2: Message Flow Comparison %%
sequenceDiagram
    participant Host as Host Application
    participant MCP_Client as MCP Client
    participant MCP_Server as MCP Server<br/>(Tool/Resource)
    participant A2A_Client as A2A Client Agent
    participant A2A_Remote as A2A Remote Agent
    
    %% MCP Message Flow: Tool Invocation
    alt MCP Tool Invocation
        Host->>MCP_Client: Want to read file<br/>(AI reasoning)
        MCP_Client->>MCP_Server: tools/list<br/>(JSON-RPC 2.0)
        MCP_Server-->>MCP_Client: [file_read, db_query, ...]
        MCP_Client->>MCP_Server: tools/call<br/>{name: "file_read", args: {path: "/doc.pdf"}}
        MCP_Server-->>MCP_Client: File content<br/>(base64 encoded)
        MCP_Client-->>Host: File content<br/>(for AI processing)
    end
    
    %% A2A Message Flow: Task Delegation
    opt A2A Task Delegation
        A2A_Client->>A2A_Remote: GET /.well-known/agent-card<br/>(Discovery)
        A2A_Remote-->>A2A_Client: {skills: [summarization, translation], ...}
        A2A_Client->>A2A_Remote: POST /tasks<br/>{taskId: "t1", skill: "summarization", input: {...}}
        A2A_Remote-->>A2A_Client: 202 Accepted<br/>{taskId: "t1", status: "accepted"}
        A2A_Remote->>A2A_Remote: Process task<br/>(AI work)
        A2A_Remote->>A2A_Client: POST /tasks/t1/result<br/>{status: "completed", result: "Summary text"}
        A2A_Client->>A2A_Client: Use result<br/>(Continue workflow)
    end
    
    %% Combined Workflow Example
    seq Combined MCP+A2A Workflow
        Host->>MCP_Client: Need to analyze sales data
        MCP_Client->>MCP_Server: tools/call<br/>{name: "db_query", args: {query: "SELECT * FROM sales"}}
        MCP_Server-->>MCP_Client: Raw sales data (CSV)
        MCP_Client-->>Host: Sales data
        Host->>A2A_Client: Complex analysis needed
        A2A_Client->>A2A_Remote: POST /tasks<br/>{skill: "data_analysis", input: sales_data}
        A2A_Remote-->>A2A_Client: 202 Accepted
        A2A_Remote->>A2A_Remote: Analyze data<br/>(ML models, stats)
        A2A_Remote->>A2A_Client: POST /tasks/t2/result<br/>{insights: ["Q3 up 15%", "Trend: seasonal"]}
        A2A_Client-->>Host: Analysis insights
    end
